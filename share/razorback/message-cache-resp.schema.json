  "title": "Razorback Cache Response Message Body",
  "description": "Canonical JSON body emitted by CacheResp_Serialize().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Block_ID",
    "SF_Flags",
    "Ent_Flags"
  ],
  "properties": {
    "Block_ID": {
      "$ref": "block-id.schema.json"
    },
    "SF_Flags": {
