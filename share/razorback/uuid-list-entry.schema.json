{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Razorback UUID List Entry",
  "description": "Canonical JSON array entry emitted by JsonBuffer_Put_UUIDList().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    }
  }
}
