{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Razorback Output Log Message Body",
  "description": "Canonical JSON body emitted by OutputLog_Serialize().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Nugget",
    "Priority",
    "Seconds",
    "Nano_Seconds",
    "Message"
  ],
  "properties": {
    "Nugget": {
      "$ref": "nugget.schema.json"
    },
    "Event": {
      "$ref": "event.schema.json"
    },
    "Priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "Seconds": {
      "type": "integer",
      "minimum": 0
    },
    "Nano_Seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999999999
    },
    "Message": {
      "type": "string"
    }
  }
}
