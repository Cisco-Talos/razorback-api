{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Razorback NTLV Item",
  "description": "Canonical JSON array entry emitted by JsonBuffer_Put_NTLVList().",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Name",
    "Type"
  ],
  "properties": {
    "Name": {
      "$ref": "uuid.schema.json"
    },
    "Type": {
      "$ref": "uuid.schema.json"
    },
    "String_Value": {
      "type": "string"
    },
    "Bin_Value": {
      "type": "string",
      "contentEncoding": "base64"
    },
    "Json_Value": {
      "type": [
        "object",
        "array"
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "String_Value"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "Bin_Value"
            ]
          },
          {
            "required": [
              "Json_Value"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "Bin_Value"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "String_Value"
            ]
          },
          {
            "required": [
              "Json_Value"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "Json_Value"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "String_Value"
            ]
          },
          {
            "required": [
              "Bin_Value"
            ]
          }
        ]
      }
    }
  ]
}
